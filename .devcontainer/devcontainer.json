// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "tf2-py3",
	"build": { 
		"context": "..",
		"dockerfile": "Dockerfile"
	},

	// Features to add to the dev container. More info: https://containers.dev/features.
	//"features": {},

	// Use 'forwardPorts' to make a list of ports inside the container available locally.
	// "forwardPorts": [],

	// Runs after the workspace is mounted, so the editable install points at the
	// live source tree rather than a build-time copy. Makes `upwins_veg` importable.
	"postCreateCommand": "python -m pip install --no-cache-dir -e .",

	// Configure tool-specific properties.
	"customizations": {
		"vscode": {
		  "extensions": ["ms-toolsai.jupyter", "ms-python.python"]
		}
	  },

	"runArgs": ["--gpus","all"],

	// Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
	//"remoteUser": "root",

	// Mounts an external data directory over the repo's data/ so large data can
	// live outside the repo. The host path below is hardcoded: edit it if your
	// data is not at ~/projects/upwins/data, or Docker will create an empty
	// directory there and the notebooks will fail with missing-file errors.
	// See the Data section of README.md.
	"mounts": ["source=${localEnv:HOME}/projects/upwins/data,target=/workspaces/upwins-veg-classifier/data,type=bind,consistency=cached"]
	//"source=/mnt/d,target=/workspaces/upwins-veg-classifier/data/D-drive,type=bind,consistency=cached"]
}
